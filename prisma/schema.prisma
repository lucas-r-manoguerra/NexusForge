// NexusForge — Prisma Schema
// Convention: every model has id (UUID), createdAt, updatedAt.
// Model names: PascalCase singular. Field names: camelCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetSource {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // "polyhaven", "kenney", etc.
  name        String
  baseUrl     String
  adapterType String // "api" | "scraping"
  assets      Asset[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Asset {
  id            String   @id @default(uuid()) @db.Uuid
  sourceId      String   @db.Uuid
  sourceAssetId String   // source-specific ID (not unique alone)
  name          String
  description   String?
  type          String   // AssetType as string
  spdxId        String   // License SPDX
  licenseName   String
  commercial    Boolean
  attribution   Boolean
  downloadUrl   String
  thumbnailUrl  String?
  tags          String[] // PostgreSQL array
  metadata      Json     // source-specific extras
  discoveredAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  source AssetSource @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, sourceAssetId])
  @@index([type])
  @@index([sourceId])
}
